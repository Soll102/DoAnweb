# Copy file này thành `.env` rồi điền key thật (lấy tại https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-paste-key-cua-ban-vao-day
# Model OpenRouter cho chatbot Marina.
# Bạn đang muốn dùng: qwen/qwen3.8-27b:free
# Nếu model đó báo 404/không tồn tại, đổi sang 1 trong các model free đang sống:
#   qwen/qwen3-next-80b-a3b-instruct:free
#   google/gemma-4-26b-a4b-it:free
#   nvidia/nemotron-3-super-120b-a12b:free
#   openrouter/free   (tự route sang model free ngẫu nhiên)
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_SITE_URL=http://127.0.0.1:5000
OPENROUTER_APP_NAME=AZUREA ISLANDS Marina
